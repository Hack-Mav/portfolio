# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and should not be committed.
# For production, set these values in your CI/CD environment or Secret Manager.

# App metadata
VITE_APP_NAME=Portfolio
VITE_APP_VERSION=${npm_package_version}

# Sentry error tracking (public DSN, but store in CI/Secret Manager)
VITE_SENTRY_DSN=your_sentry_dsn_here

# Formspree contact form endpoint
VITE_FORMSPREE_FORM_ID=your_formspree_id_here

# API base URL (used by ApiClient utilities)
VITE_API_BASE_URL=/api

# Optional: GCP identifiers for deployment scripts (not used by the browser bundle)
GCP_PROJECT_ID=your_gcp_project_id
GCP_APP_NAME=your_gcp_app_name
